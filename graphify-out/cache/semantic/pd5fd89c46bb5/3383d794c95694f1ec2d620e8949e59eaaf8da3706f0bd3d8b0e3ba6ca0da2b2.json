, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "system_overview_connection_manager", "label": "ConnectionManager WebSocket Broadcast", "file_type": "code", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "system_overview_fastapi_rest_api", "label": "FastAPI REST API", "file_type": "code", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:108", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "system_overview_react_dashboard", "label": "React Dashboard", "file_type": "code", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "system_overview_startup_sequence", "label": "Startup Sequence", "file_type": "concept", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:134-143", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "system_overview_per_frame_pipeline", "label": "Per-Frame Pipeline Flow", "file_type": "concept", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:145-165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "system_overview_module_dependency_graph", "label": "Module Dependency Graph", "file_type": "concept", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:167-184", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "system_overview_face_analysis_misnomer", "label": "MediaPipe Analyzer Misnomer", "file_type": "rationale", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:298", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The module is named 'MediaPipe Pose' but actually uses FaceLandmarker (468 face landmarks), not PoseLandmarker (33 body keypoints). No full-body skeletal tracking or hand landmark detection is implemented. The naming is misleading."}, {"id": "system_overview_vlm_incompatibility", "label": "Moondream VLM Incompatibility", "file_type": "rationale", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:561", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moondream VLM uses GGUF format which is incompatible with the transformers library. This renders phone detection, cheat sheet detection, and unauthorized items detection non-functional as they depend on VLM analysis."}, {"id": "system_overview_single_camera_limitation", "label": "Single Camera Limitation", "file_type": "rationale", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:557", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pipeline is hardcoded to camera_id=0. Multi-camera support requires significant refactoring of CameraManager and the pipeline architecture."}, {"id": "system_overview_synchronous_db_writes", "label": "Synchronous DB Writes Design Decision", "file_type": "rationale", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:349", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EventLogger writes synchronously using get_db_session(), which blocks the pipeline during DB writes. Acceptable for MVP throughput but limits scalability. Uses SQLite StaticPool (single connection) which is thread-safe but not concurrent."}, {"id": "system_overview_no_auth", "label": "Missing Authentication", "file_type": "rationale", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:389", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No authentication middleware exists. WebSocket URL has hardcoded ?token=demo. Anyone can access the API and manage exams. This is a HIGH severity limitation."}, {"id": "system_overview_no_phone_detection", "label": "Missing Phone/Object Detection", "file_type": "rationale", "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YOLOv8 only detects persons (COCO class 0). No phone, book, or hand detection. AnomalyDetector has phone/cheat sheet rules but they depend on VLM analysis which is non-functional. Custom YOLO training or multi-class model needed."}], "edges": [{"source": "system_overview_run_pipeline", "target": "system_overview_camera_manager", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:148", "weight": 1.0}, {"source": "system_overview_run_pipeline", "target": "system_overview_detection_engine", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:149", "weight": 1.0}, {"source": "system_overview_run_pipeline", "target": "system_overview_tracking_engine", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:151", "weight": 1.0}, {"source": "system_overview_run_pipeline", "target": "system_overview_mediapipe_analyzer", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:154", "weight": 1.0}, {"source": "system_overview_run_pipeline", "target": "system_overview_anomaly_detector", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SYSTEM_OVERVIEW.md", "source_location": "SYSTEM_OVERVIEW.md:156", "weight": 1.0}, {"source": "system_overview_run_pipeline", "target": "system_overvi