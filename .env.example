# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-12345
API_TITLE=Exam Surveillance System
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite (development)
DATABASE_URL=sqlite:///./data/exam_surveillance.db
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=0

# PostgreSQL (production - uncomment and configure)
# DATABASE_URL=postgresql://exam_user:secure_password@db.example.com:5432/exam_surveillance

# ============================================================================
# REDIS CONFIGURATION (Caching & Session Management)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300
REDIS_POOL_SIZE=10

# ============================================================================
# CAMERA CONFIGURATION
# ============================================================================
NUM_CAMERAS=1
CAMERA_FPS=30
CAMERA_RESOLUTION_WIDTH=1280
CAMERA_RESOLUTION_HEIGHT=720
CAMERA_BUFFER_SIZE=3
CAMERA_TIMEOUT_SECONDS=5

# Camera indices (for USB cameras: 0, 1, 2...)
# IP cameras: rtsp://user:pass@camera_ip:port/stream
CAMERA_0_SOURCE=0

# ============================================================================
# MODEL PATHS
# ============================================================================
YOLOV8_MODEL_PATH=./models/yolov8n.pt
YOLOV8_CONFIDENCE_THRESHOLD=0.5
YOLOV8_NMS_THRESHOLD=0.45

# LM Studio Local Vision-Language Model (OpenAI-compatible REST API)
# Start LM Studio Local Server (default: 1234) and load any vision model (Qwen2-VL, Moondream, etc.)
VLM_ENABLED=True
VLM_BASE_URL=http://127.0.0.1:1234/v1
VLM_MODEL=qwen/qwen3-vl-4b
VLM_MAX_TOKENS=512
VLM_TIMEOUT=60

# ============================================================================
# GPU CONFIGURATION
# ============================================================================
USE_GPU=True
GPU_DEVICE_ID=0
GPU_MEMORY_FRACTION=0.7
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_VISIBLE_DEVICES=0

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
DATA_STORAGE_PATH=/data
VIDEO_STORAGE_PATH=/data/videos
CLIPS_STORAGE_PATH=/data/clips
SCREENSHOTS_STORAGE_PATH=/data/screenshots
REPORTS_STORAGE_PATH=/data/reports
LOGS_STORAGE_PATH=/data/logs

VIDEO_CODEC=h264
VIDEO_BITRATE=2000k
VIDEO_CRF=23

VIDEO_RETENTION_DAYS=90
CLIPS_RETENTION_DAYS=90
SCREENSHOTS_RETENTION_DAYS=180
LOGS_RETENTION_DAYS=365

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/data/logs/app.log
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=10

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_AUDIO_ANALYSIS=True
ENABLE_MULTIMODAL_ANALYSIS=True
ENABLE_IDENTITY_VERIFICATION=False
ENABLE_FACE_RECOGNITION=False
ENABLE_STORAGE_CLEANUP=True

# ============================================================================
# ALERT & NOTIFICATION SETTINGS
# ============================================================================
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT=5

ENABLE_EMAIL_ALERTS=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@exam-surveillance.local
ALERT_EMAIL_TO=proctor@exam.local

ENABLE_SMS_ALERTS=False
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_PHONE_NUMBER=

# ============================================================================
# ANOMALY DETECTION THRESHOLDS
# ============================================================================
GAZE_DEVIATION_THRESHOLD_FRAMES=30
GAZE_DEVIATION_ANGLE=30

HAND_FACE_PROXIMITY_THRESHOLD=80
HAND_FACE_CONSECUTIVE_FRAMES=3

HEAD_POSE_EXTREME_ANGLE=45
HEAD_POSE_FRAME_DURATION=5

AUDIO_ANOMALY_THRESHOLD_DB=65
AUDIO_ANOMALY_DURATION_SECONDS=2

POSTURE_BEND_ANGLE_THRESHOLD=45
POSTURE_DURATION_THRESHOLD=5

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
FRAME_SKIP_RATIO=1
BATCH_INFERENCE_SIZE=4
MAX_CONCURRENT_TRACKS=100
WEBSOCKET_FRAME_RATE=2
WEBSOCKET_BATCH_SIZE=5

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

ENABLE_HTTPS=False
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_METRICS_ENABLED=True
PROMETHEUS_METRICS_PORT=9090

DATADOG_ENABLED=False
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE_NAME=exam-surveillance

# ============================================================================
# DATABASE MIGRATION
# ============================================================================
ALEMBIC_SQLALCHEMY_URL=sqlite:///./data/exam_surveillance.db